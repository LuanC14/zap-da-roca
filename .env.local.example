# ── Supabase ─────────────────────────────────────────────────────────────────
# LOCAL (Supabase CLI — `npm run db:start`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   As chaves abaixo são as padrão do ambiente local (públicas, não secretas):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7kyqd192Zcanh9iu-Vofj4xI4TyoAsGD_U
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SB38

# PRODUÇÃO (Supabase Cloud — substituir com os valores reais):
# NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima
# SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# ── WhatsApp Business Cloud API (Meta Developer Console) ─────────────────────
WHATSAPP_TOKEN=seu_token_de_acesso
WHATSAPP_PHONE_NUMBER_ID=id_do_numero_de_telefone
WHATSAPP_APP_SECRET=seu_app_secret
WHATSAPP_VERIFY_TOKEN=qualquer_string_secreta_para_verificar_webhook

# ── Ngrok (tunnel local para webhook WhatsApp) ───────────────────────────────
# Crie conta gratuita em ngrok.com → Dashboard → Your Authtoken
NGROK_AUTHTOKEN=seu_authtoken_do_ngrok

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# Painel: https://www.mercadopago.com.br/developers/panel
# Use credenciais de TESTE para dev local (prefixo APP_USR- da aba "Credenciais de teste")
MP_ACCESS_TOKEN=APP_USR-seu_access_token
MP_PUBLIC_KEY=APP_USR-sua_public_key
# Segredo de assinatura dos webhooks (Mercado Pago → Suas integrações → Webhooks → Chave secreta).
# OBRIGATÓRIO em produção: sem ele /api/pagamento/webhook responde 503.
MP_WEBHOOK_SECRET=chave_secreta_do_webhook
# SOMENTE sandbox: força o e-mail do pagador. Remova em produção, senão todo pagamento usa esse e-mail.
# MP_TEST_PAYER_EMAIL=test_user_xxx@testuser.com

# ── App URL (usado nos redirects de pagamento e email) ───────────────────────
# Local: http://localhost:3000  |  Produção: https://zapdaroca.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron / Lembretes ─────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32  (sem ele a rota /api/cron recusa tudo, inclusive o agendador da Vercel)
CRON_SECRET=string_aleatoria_longa_para_proteger_rota_do_cron
