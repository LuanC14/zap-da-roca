# Copie para .env.deploy (gitignored) e preencha. Usado por scripts/provision.mjs, scripts/rls-check.mjs
# e scripts/smoke-prod.mjs. Nunca commite o .env.deploy.

# ── Site ─────────────────────────────────────────────────────────────────────
# Host canônico (o outro, www/apex, passa a redirecionar para ele)
SITE_URL=https://zapdaroca.com.br

# ── Vercel ───────────────────────────────────────────────────────────────────
# Token: vercel.com/account/tokens (escopo do time/projeto)
VERCEL_TOKEN=
VERCEL_PROJECT=zap-da-roca
# Só se o projeto estiver em um time (Settings → General → Team ID)
VERCEL_TEAM_ID=
# Opcional: Settings → Git → Deploy Hooks (permite o redeploy automático)
VERCEL_DEPLOY_HOOK_URL=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Token: supabase.com/dashboard/account/tokens (o mesmo usado pelo GitHub Actions)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=eroyhtdcfmffpyjpohke
# Só para scripts/rls-check.mjs
SUPABASE_URL=https://eroyhtdcfmffpyjpohke.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (opcional) ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_DOMAIN_ID=6c136be9-114a-410a-8f7b-3b5b3c07ba76
# Remetente usado no SMTP do Supabase (padrão: noreply@<domínio>)
SMTP_FROM=

# ── WhatsApp Business (Meta) ─────────────────────────────────────────────────
# IDs: developers.facebook.com → app → WhatsApp → API Setup (Phone number ID / WhatsApp Business Account ID)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Token PERMANENTE de usuário do sistema (Business Settings → System users) — o temporário expira em ~24 h
WHATSAPP_TOKEN=
# App settings → Basic → App secret
WHATSAPP_APP_SECRET=
# Qualquer string longa e aleatória; a mesma vai no campo "Verify token" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Preencher quando os templates estiverem APPROVED
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_LANG=pt_BR
